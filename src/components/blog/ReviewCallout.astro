---
import StarRating from './StarRating.astro';
import type { ReviewCalloutData } from '../../lib/seo/review';
import { formatPublicationDate } from '../../lib/seo/review';

interface Props {
  review: ReviewCalloutData;
  bodyHtml?: string;
  aspectHtml: Record<string, string>;
  authors: Array<{ displayName: string; profilePath: string }>;
}

const { review, bodyHtml = '', aspectHtml, authors } = Astro.props;
const { item } = review;
const reviewerNames = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' })
  .format(authors.map((author) => author.displayName));
const ratingLabel = reviewerNames ? `${reviewerNames}'s rating` : 'Rating';
const hasDetails = item.creator || item.publisher || item.bookEdition || item.inLanguage || item.datePublished;
let languageName = item.inLanguage;
if (item.inLanguage) {
  try {
    languageName = new Intl.DisplayNames(['en'], { type: 'language' }).of(item.inLanguage);
  } catch {
    // Preserve an unfamiliar language label without breaking the review.
  }
}
---

<section id={review.id} class="review-callout" aria-labelledby={`${review.id}-title`}>
  <header class="review-callout__header">
    <div class="review-callout__identity">
      <h3 id={`${review.id}-title`} class="review-callout__title">
        <a href={`#${review.id}`} title="Link to this review">
          {review.title}<svg class="review-callout__anchor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
        </a>
      </h3>
      <p id={`${review.id}-item`} class="review-callout__item">
        {item.url ? <a href={item.url}>{item.name}</a> : item.name}
      </p>
    </div>
    <div class="review-callout__overall">
      <span class="review-callout__label">{ratingLabel}</span>
      <StarRating id={`${review.id}-rating`} rating={review.rating} bestRating={review.bestRating} prominent />
    </div>
    {hasDetails && (
      <dl class="review-callout__details">
        {item.creator && (
          <div>
            <dt>Created by</dt>
            <dd>{item.creator.url ? <a href={item.creator.url}>{item.creator.name}</a> : item.creator.name}</dd>
          </div>
        )}
        {item.publisher && (
          <div>
            <dt>Publisher</dt>
            <dd>{item.publisher.url ? <a href={item.publisher.url}>{item.publisher.name}</a> : item.publisher.name}</dd>
          </div>
        )}
        {(item.bookEdition || item.inLanguage) && (
          <div>
            <dt>Edition</dt>
            <dd>
              {item.bookEdition}
              {item.bookEdition && item.inLanguage && <span aria-hidden="true"> · </span>}
              {item.inLanguage && (
                <span>
                  {['fr', 'fr-fr'].includes(item.inLanguage.toLowerCase()) && <span aria-hidden="true">🇫🇷 </span>}
                  <abbr title={languageName}>{item.inLanguage.split('-')[0].toUpperCase()}</abbr> version
                </span>
              )}
            </dd>
          </div>
        )}
        {item.datePublished && (
          <div>
            <dt>Published</dt>
            <dd>
              {item.datePublished.length === 4
                ? item.datePublished
                : <time datetime={item.datePublished}>{formatPublicationDate(item.datePublished)}</time>}
            </dd>
          </div>
        )}
      </dl>
    )}
    {authors.length > 0 && (
      <p class="review-callout__byline">
        Reviewed by{' '}
        {authors.map((author, index) => (
          <>
            {index > 0 && (index === authors.length - 1 ? ' and ' : ', ')}
            <a href={author.profilePath} rel="author">{author.displayName}</a>
          </>
        ))}
      </p>
    )}
  </header>

  {bodyHtml && (
    <div class="review-callout__verdict review-callout__body">
      <Fragment set:html={bodyHtml} />
    </div>
  )}

  <div class="review-callout__aspects">
    {review.aspects.map((aspect) => (
      <section id={aspect.id} class="review-callout__aspect" aria-labelledby={`${aspect.id}-title`}>
        <div class="review-callout__aspect-heading">
          <h4 id={`${aspect.id}-title`}>
            <a href={`#${aspect.id}`} title={`Link to ${aspect.label.toLowerCase()} rating`}>
              {aspect.label}<svg class="review-callout__anchor" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
            </a>
          </h4>
          <StarRating id={`${aspect.id}-rating`} rating={aspect.rating} bestRating={review.bestRating} />
        </div>
        <div class="review-callout__body">
          <Fragment set:html={aspectHtml[aspect.id] ?? ''} />
        </div>
      </section>
    ))}
  </div>
</section>

<style>
  .review-callout {
    margin: 2.25rem 0;
    border: 1px solid hsl(var(--border));
    border-top: 3px solid #efbd68;
    border-radius: 0.5rem;
    background: hsl(var(--foreground) / 0.025);
    color: hsl(var(--foreground));
    overflow-wrap: anywhere;
    scroll-margin-top: 8.5rem;
  }

  .review-callout__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding: 1.5rem;
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--foreground) / 0.025);
  }

  .review-callout__identity {
    flex: 1 1 15rem;
    min-width: 0;
  }

  .review-callout .review-callout__title {
    margin: 0 0 0.5rem;
    padding: 0;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .review-callout .review-callout__item {
    margin: 0;
    color: hsl(var(--body-text));
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .review-callout .review-callout__byline {
    flex-basis: 100%;
    margin: 0;
    color: hsl(var(--body-text));
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .review-callout__details {
    flex-basis: 100%;
    display: grid;
    gap: 0.35rem;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .review-callout__details > div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 0.75rem;
  }

  .review-callout__details dt {
    color: hsl(var(--body-text));
  }

  .review-callout__details dd {
    margin: 0;
    color: hsl(var(--foreground));
  }

  .review-callout__details abbr {
    text-decoration: none;
  }

  .review-callout__overall {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    min-width: 0;
  }

  .review-callout__label {
    color: hsl(var(--body-text));
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .review-callout__aspects {
    padding: 0 1.5rem;
  }

  .review-callout__verdict {
    padding: 1.5rem;
    border-bottom: 1px solid hsl(var(--border));
  }

  .review-callout__aspect {
    padding: 1.5rem 0;
    scroll-margin-top: 8.5rem;
  }

  .review-callout__aspect + .review-callout__aspect {
    border-top: 1px solid hsl(var(--border));
  }

  .review-callout__aspect-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem 1rem;
    margin-bottom: 0.9rem;
  }

  .review-callout .review-callout__aspect-heading h4 {
    margin: 0;
    padding: 0;
    font-size: 1.1rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .review-callout .review-callout__title a,
  .review-callout .review-callout__aspect-heading a {
    color: inherit;
    background: transparent;
    text-decoration: none;
  }

  .review-callout .review-callout__title a:hover,
  .review-callout .review-callout__aspect-heading a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .review-callout a:focus-visible {
    outline: 2px solid #efbd68;
    outline-offset: 4px;
    border-radius: 2px;
  }

  .review-callout__anchor {
    display: inline-block;
    margin-left: 0.4em;
    width: 0.75em;
    height: 0.75em;
    vertical-align: -0.05em;
    color: hsl(var(--body-text));
    opacity: 0.6;
  }

  .review-callout__body {
    color: hsl(var(--body-text));
    font-size: 1rem;
    line-height: 1.65;
  }

  .review-callout .review-callout__body :global(p) {
    margin: 0 0 1.1rem;
    font-size: inherit;
    line-height: inherit;
  }

  .review-callout .review-callout__body :global(> :last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 400px) {
    .review-callout__details > div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .review-callout__details {
      gap: 0.65rem;
    }

    .review-callout__header {
      padding: 1.1rem;
      gap: 1.1rem;
    }

    .review-callout__aspects {
      padding: 0 1.1rem;
    }

    .review-callout__verdict {
      padding: 1.1rem;
    }

    .review-callout__aspect {
      padding: 1.1rem 0;
    }

    .review-callout__aspect-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

---
import StarRating from './StarRating.astro';
import type { ReviewCalloutData } from '../../lib/seo/review';

interface Props {
  src: string;
  title: string;
  review: ReviewCalloutData;
  authors: Array<{ displayName: string }>;
  href: string;
  compact?: boolean;
}

const { src, title, review, authors, href, compact = false } = Astro.props;
const reviewerNames = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' })
  .format(authors.map((author) => author.displayName));
const ratingLabel = reviewerNames ? `${reviewerNames}'s rating` : 'Rating';
const ratingId = `review-cover-${compact ? 'card' : 'hero'}-${encodeURIComponent(href)}-rating`;
---

<a
  href={href}
  class:list={['review-cover', { 'review-cover--compact': compact }]}
  aria-label={`Read ${compact ? title : `${review.title} review`}. ${ratingLabel}: ${review.rating} out of ${review.bestRating}.`}
>
  <span class="review-cover__photograph">
    <img
      src={src}
      alt={title}
      loading={compact ? 'lazy' : 'eager'}
      fetchpriority={compact ? 'auto' : 'high'}
    />
  </span>
  <span class="review-cover__badge">
    <span class="review-cover__label">{ratingLabel}</span>
    <StarRating id={ratingId} rating={review.rating} bestRating={review.bestRating} />
  </span>
</a>

<style>
  .review-cover {
    --review-cover-label-size: clamp(0.65rem, 1.25cqw, 0.8rem);
    --review-cover-star-size: clamp(0.9rem, 2cqw, 1.25rem);
    --review-cover-value-size: clamp(0.9rem, 1.8cqw, 1.15rem);
    display: block;
    position: relative;
    container-type: inline-size;
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: #111312;
    color: #f5f1e9;
    text-decoration: none;
    isolation: isolate;
  }

  .review-cover:focus-visible {
    outline: 3px solid hsl(var(--foreground));
    outline-offset: -3px;
  }

  .review-cover__photograph {
    display: block;
    position: absolute;
    inset: 0;
    background: #0b0d0c;
  }

  .review-cover__photograph img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .review-cover:not(.review-cover--compact) .review-cover__photograph::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, #000, transparent 8%, transparent 92%, #000),
      linear-gradient(180deg, rgb(0 0 0 / 0.42), transparent 35%),
      linear-gradient(0deg, #000, transparent 20%);
    pointer-events: none;
  }

  .review-cover__badge {
    position: absolute;
    right: clamp(1.25rem, 5cqw, 3.75rem);
    top: clamp(1.25rem, 5cqw, 3.75rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    max-width: calc(100% - 2.5rem);
    padding: clamp(0.5rem, 1.15cqw, 0.85rem) clamp(0.65rem, 1.5cqw, 1rem);
    border: 1px solid rgb(239 189 104 / 0.3);
    border-radius: 0;
    background: rgb(15 20 24 / 0.78);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.2);
  }

  .review-cover__label {
    color: #d5c3a4;
    font-size: var(--review-cover-label-size);
    font-weight: 500;
    letter-spacing: 0.015em;
    line-height: 1.3;
  }

  .review-cover :global(.star-rating) {
    gap: 0.5rem;
    color: #f5f1e9;
  }

  .review-cover :global(.star-rating__stars) {
    gap: 0.1rem;
  }

  .review-cover :global(.star-rating__stars svg) {
    width: var(--review-cover-star-size);
    height: var(--review-cover-star-size);
  }

  .review-cover :global(.star-rating__value) {
    font-size: var(--review-cover-value-size);
  }

  .review-cover :global(.star-rating__maximum) {
    color: #d5c3a4;
  }

  .review-cover--compact {
    --review-cover-label-size: 0.65rem;
    --review-cover-star-size: 0.9rem;
    --review-cover-value-size: 0.9rem;
    aspect-ratio: 16 / 9;
  }

  @media (max-width: 768px) {
    .review-cover--compact {
      aspect-ratio: 21 / 9;
    }
  }

</style>

---
import { getCollection } from 'astro:content';
import Avatar from '../Avatar.astro';
import { AVATAR_MEDIA } from '../../data/avatarMedia';
import {
  HOME_FEATURED_KRAYORN,
  HOME_FEATURED_LUDO_SLUG,
} from '../../data/homeFeaturedArticles';
import { blogSlug, blogUrl } from '../../lib/blog/posts';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const featuredPost = allPosts.find((post) => blogSlug(post) === HOME_FEATURED_LUDO_SLUG);
const krayornFeature = HOME_FEATURED_KRAYORN;
const ludoAvatarMedia = AVATAR_MEDIA.ludo;
const krayornAvatarMedia = AVATAR_MEDIA.krayorn;
---

<script>
  import '../../scripts/hero-animations';
</script>

<section class="hero" aria-labelledby="home-hero-title">
  <div class="hero-purpose">
    <h1 class="hero-title" id="home-hero-title">Immersive&nbsp;<span class="hero-tt">TT</span>RPG Experiences</h1>
    <p class="hero-baseline">
      Creative experiments mixing narrative, visuals, props, and technology to design rich tabletop RPG experiences.
      A space for imagination, fun, and design to meet.
    </p>
  </div>

  <div class="hero-features" aria-label="Featured articles">
    {featuredPost && (
      <article class="hero-feature hero-feature--ludo" aria-labelledby="featured-post-title-ludo">
        <a
          href={blogUrl(featuredPost)}
          class="hero-latest"
          data-fathom-event="Click Ludo Featured Post | Home"
        >
          <h2 id="featured-post-title-ludo">{featuredPost.data.title}</h2>
          <span class="read-more">Read more →</span>
        </a>

        <div class="hero-author">
          <a
            href="/about/ludo/"
            class="hero-avatar"
            rel="author"
            aria-label="More about Ludo"
            data-fathom-event="Click Ludo Avatar | Home"
          >
            <Avatar
              chance={0.2}
              alt=""
              hoverVideoSrc={ludoAvatarMedia.hoverVideoSrc}
              loading="eager"
              posterSrc={ludoAvatarMedia.posterSrc}
              videoSrcs={ludoAvatarMedia.ambientVideoSrcs}
            />
          </a>
        </div>
      </article>
    )}

    <article class="hero-feature hero-feature--krayorn" aria-labelledby="featured-post-title-krayorn">
      <a
        href={krayornFeature.url}
        class="hero-latest"
        target="_blank"
        rel="noopener noreferrer"
        data-fathom-event="Click Krayorn Featured Post | Home"
      >
        <h2 id="featured-post-title-krayorn">{krayornFeature.title}</h2>
        <span class="read-more">Read more →</span>
      </a>

      <div class="hero-author">
        <a
          href="/about/#krayorn"
          class="hero-avatar"
          rel="author"
          aria-label="More about Krayorn"
          data-fathom-event="Click Krayorn Avatar | Home"
        >
          <Avatar
            alt=""
            chance={0.2}
            hoverVideoSrc={krayornAvatarMedia.hoverVideoSrc}
            loading="eager"
            mediaFilter={krayornAvatarMedia.mediaFilter}
            posterSrc={krayornAvatarMedia.posterSrc}
            videoSrcs={krayornAvatarMedia.ambientVideoSrcs}
          />
        </a>
      </div>
    </article>
  </div>
</section>

<style>
  /* ===== MOBILE (Default) ===== */
  .hero {
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .hero-features {
    display: grid;
    grid-template-areas:
      'ludo-bubble ludo-bubble'
      'ludo-avatar krayorn-avatar'
      'krayorn-bubble krayorn-bubble';
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1rem;
    row-gap: 0.625rem;
    width: 100%;
  }

  .hero-feature {
    display: contents;
  }

  .hero-author {
    align-self: center;
    align-items: center;
    display: flex;
    flex-direction: column;
    justify-self: center;
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .hero-feature--ludo .hero-latest {
    grid-area: ludo-bubble;
  }

  .hero-feature--ludo .hero-author {
    grid-area: ludo-avatar;
  }

  .hero-feature--krayorn .hero-latest {
    grid-area: krayorn-bubble;
  }

  .hero-feature--krayorn .hero-author {
    grid-area: krayorn-avatar;
  }

  .hero-avatar {
    position: relative;
  }

  .hero-avatar :global(.avatar-media) {
    --avatar-size: 100px;
    --avatar-border: none;
    transition: transform 0.3s ease;
  }

  .hero-avatar:hover :global(.avatar-media),
  .hero-avatar:focus-visible :global(.avatar-media) {
    transform: scale(1.05);
  }

  .hero-purpose {
    grid-area: purpose;
    text-align: center;
    width: 100%;
    max-width: 100%;
    justify-self: center;
    position: relative;
    min-width: 0;
    overflow: hidden;
  }

  /* Subtle glow behind punchline */
  .hero-purpose::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse at center,
      rgba(255, 255, 255, 0.12) 0%,
      rgba(255, 255, 255, 0.06) 40%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .hero-title {
    font-family: 'Rajdhani', sans-serif;
    /* Dynamic font size based on viewport width */
    font-size: clamp(2rem, 7vw, 5rem);
    font-weight: 700;
    line-height: 1.1;
    /* Dynamic letter spacing based on viewport width */
    letter-spacing: clamp(0em, 0.6vw, 0.1em);
    margin: 0 0 1.5rem 0;
    text-transform: uppercase;
    position: relative;
    z-index: 1;
    text-wrap: pretty;

    /* Outline text - schematic aesthetic */
    color: transparent !important;
    background: transparent !important;
    -webkit-text-fill-color: transparent !important;
    /* Dynamic stroke width */
    -webkit-text-stroke-width: clamp(0.75px, 0.2vw, 1.25px);
    -webkit-text-stroke-color: hsl(var(--foreground));
    text-stroke: clamp(0.75px, 0.2vw, 1.25px) hsl(var(--foreground));
  }

  /* Subdued "TT" styling with diagonal gradient */
  .hero-tt {
    font-weight: 700;
    background: linear-gradient(
      135deg,
      hsl(0 0% 15%) 0%,
      hsl(0 0% 25%) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke-width: 0;
    text-stroke: 0;
  }

  .hero-baseline {
    font-size: 1;
    font-weight: 400;
    line-height: 1.7;
    color: hsl(var(--foreground));
    margin: 0;
    letter-spacing: 0.015em;
    opacity: 0.9;
    text-align: center;
    text-wrap: pretty;

    margin-left: auto;
    margin-right: auto;
    position: relative;
    z-index: 1;
  }

  .hero-latest {
    padding: 1.5rem 1.5rem 1rem 1.5rem;
    color: hsl(var(--background));
    position: relative;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    min-width: 0;
    margin-bottom: 0;
    z-index: 2;
    text-decoration: none;
    display: block;
    cursor: pointer;
    transition: transform 0.2s ease-out;
    isolation: isolate;
  }

  /* On hover, lift up and scale slightly */
  .hero-latest:hover {
    transform: translateY(-4px) scale(1.02);
  }

  /* Background with gradient, mirrored toward each author. */
  .hero-latest::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      225deg,
      hsl(0 0% 50%) 0%,
      hsl(0 0% 96%) 70%
    );
    z-index: 1;
    pointer-events: none;
  }

  .hero-feature--krayorn .hero-latest::before {
    background: linear-gradient(
      45deg,
      hsl(0 0% 50%) 0%,
      hsl(0 0% 96%) 70%
    );
  }

  /* On hover, switch to solid off-white instantly (no transition to avoid blink) */
  .hero-feature .hero-latest:hover::before {
    background: hsl(0 0% 96%);
  }

  /* Mobile: Ludo's bubble sits above the shared avatar row. */
  .hero-latest::after {
    content: '';
    position: absolute;
    background: transparent;
    border-top: 50px solid hsl(0 0% 96%);
    border-left: 8px solid transparent;
    border-right: 40px solid transparent;
    bottom: -28px;
    clip-path: none;
    height: 0;
    left: calc(25% + 40px);
    top: auto;
    transform: translateX(-50%) skewX(-22deg);
    width: 0;
    filter: drop-shadow(2px 3px 4px rgba(0, 0, 0, 0.3));
    z-index: 0;
    pointer-events: none;
  }

  /* Krayorn's bubble sits below the shared avatar row. */
  .hero-feature--krayorn .hero-latest::after {
    border-bottom: 50px solid hsl(0 0% 96%);
    border-left: 40px solid transparent;
    border-right: 8px solid transparent;
    border-top: 0;
    bottom: auto;
    left: calc(75% - 40px);
    top: -28px;
    transform: translateX(-50%) skewX(-22deg);
  }

  .hero-latest h2 {
    font-family: 'Bangers', cursive;
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    border: none;
    padding: 0;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-align: left;
    position: relative;
    z-index: 4;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.9);
  }

  .hero-feature--krayorn .hero-latest h2 {
    text-align: right;
  }

  .read-more {
    color: hsl(var(--background));
    display: block;
    font-size: 0.75rem;
    font-weight: 400;
    opacity: 0.6;
    position: relative;
    text-align: right;
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.9);
    z-index: 4;
  }

  /* ===== TABLET ===== */
  @media (min-width: 768px) {
    .hero {
      padding: 0;
    }

    .hero {
      align-items: center;
      gap: 5rem;
    }

    .hero-purpose {
      width: 100%;
      text-align: center;
    }

    .hero-latest {
      padding: 1.75rem 2rem 1.25rem;
    }

    .hero-avatar :global(.avatar-media) {
      --avatar-size: 112px;
    }

    .hero-purpose {
      text-align: center;
      justify-self: center;
      grid-column: 1 / -1;
    }

  }

  /* ===== DESKTOP ===== */
  @media (min-width: 900px) {
    .hero {
      gap: 5rem;
    }

    .hero-features {
      --hero-avatar-radius: clamp(46px, 4.5vw, 56px);
      --hero-avatar-size: clamp(92px, 9vw, 112px);
      grid-template-areas: none;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: none;
      gap: 1.5rem;
    }

    .hero-feature {
      align-items: center;
      display: flex;
      flex-direction: row;
      gap: 0.75rem;
      isolation: isolate;
      min-width: 0;
      position: relative;
      width: 100%;
    }

    .hero-feature--ludo {
      flex-direction: row-reverse;
    }

    .hero-latest {
      align-self: stretch;
      display: flex;
      flex: 1 1 0;
      flex-direction: column;
      justify-content: center;
      min-height: 8rem;
      padding: 1.25rem 1.5rem;
    }

    .hero-feature--ludo .hero-latest::before {
      inset: 8px 0 24px;
      transform: translateY(-20px);
    }

    .hero-feature--ludo .hero-latest h2,
    .hero-feature--ludo .hero-latest .read-more {
      transform: translateY(-28px);
    }

    .hero-feature--krayorn .hero-latest::before {
      inset: 8px 0 24px;
      /* Reflect Ludo's shortened bubble around the shared avatar centerline. */
      transform: translateY(
        calc(8rem - var(--hero-avatar-radius) - var(--hero-avatar-radius) + 36px)
      );
    }

    .hero-feature--krayorn .hero-latest h2,
    .hero-feature--krayorn .hero-latest .read-more {
      transform: translateY(
        calc(8rem - var(--hero-avatar-radius) - var(--hero-avatar-radius) + 28px)
      );
    }

    .hero-author,
    .hero-feature--krayorn .hero-author {
      align-self: flex-end;
      flex: 0 0 auto;
      margin: 0;
    }

    .hero-avatar :global(.avatar-media) {
      --avatar-size: var(--hero-avatar-size);
    }

    /* Ludo's bubble sits to the right of his avatar. */
    .hero-feature--ludo .hero-latest::after {
      background: hsl(0 0% 96%);
      border: 0;
      bottom: auto;
      clip-path: polygon(0 50%, 100% 100%, 100% 0);
      height: 34px;
      left: -36px;
      right: auto;
      top: calc(100% - var(--hero-avatar-radius) - 58px);
      transform: rotate(-18deg);
      filter: drop-shadow(-3px 2px 4px rgba(0, 0, 0, 0.3));
      width: 54px;
    }

    /* Krayorn's bubble sits to the left of his avatar. */
    .hero-feature--krayorn .hero-latest::after {
      background: hsl(0 0% 96%);
      border: 0;
      bottom: auto;
      clip-path: polygon(100% 50%, 0 100%, 0 0);
      height: 34px;
      left: auto;
      right: -36px;
      top: calc(8rem - var(--hero-avatar-radius) - var(--hero-avatar-radius) + 68px);
      transform: rotate(-18deg);
      filter: drop-shadow(3px 2px 4px rgba(0, 0, 0, 0.3));
      width: 54px;
    }
  }

  /* ===== LARGE DESKTOP (Bigger text) ===== */
  @media (min-width: 1024px) {
    .hero-title {
      font-size: 3rem;
      -webkit-text-stroke-width: 1.25px;
      text-stroke: 1.25px;
    }

    .hero-baseline {
      font-size: 1rem;
      letter-spacing: 0.02em;
    }
  }

  /* ===== SCROLL ANIMATIONS ===== */

  /* Initial state: invisible but space reserved (no layout shift) */
  .hero-avatar,
  .hero-latest {
    opacity: 0;
  }

  /* Avatar: Circular iris/mask reveal animation */
  .hero-avatar {
    clip-path: circle(0% at center);
    transition: clip-path 0.3s ease-out, opacity 0.3s ease-out;
  }

  .hero-avatar.animate-in {
    clip-path: circle(85% at center);
    opacity: 1;
  }

  /* Bubble: Pop with shake effect */
  @keyframes popShake {
    0% {
      transform: scale(0.8) rotate(0deg);
      opacity: 0;
    }
    60% {
      transform: scale(1.05) rotate(2deg);
      opacity: 1;
    }
    80% {
      transform: scale(0.98) rotate(-1deg);
    }
    100% {
      transform: scale(1) rotate(0deg);
      opacity: 1;
    }
  }

  .hero-latest {
    transform-origin: center;
  }

  .hero-latest.animate-in {
    animation: popShake 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55) 0.4s forwards;
  }

  /* Reduced motion: show immediately without animation */
  @media (prefers-reduced-motion: reduce) {
    .hero-avatar.no-motion,
    .hero-latest.no-motion {
      opacity: 1;
      clip-path: none;
      animation: none;
      transform: none;
    }
  }

  /* Desktop: adjust bubble pop animation to account for hover transform */
  @media (min-width: 900px) {
    @keyframes popShake {
      0% {
        transform: scale(0.8) rotate(0deg);
        opacity: 0;
      }
      60% {
        transform: scale(1.05) rotate(2deg);
        opacity: 1;
      }
      80% {
        transform: scale(0.98) rotate(-1deg);
      }
      100% {
        transform: scale(1) rotate(0deg);
        opacity: 1;
      }
    }
  }
</style>

---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { blogSlug, resolveBlogAsset, resolveBlogImageMetadata } from '../../lib/blog/posts';
import { getReviewSharingImage } from '../../lib/blog/review-sharing';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  const sortedPosts = posts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
  return Promise.all(sortedPosts.map(async (post) => {
    const publicSlug = blogSlug(post);

    return {
      params: { slug: publicSlug },
      props: {
        post,
        publicSlug,
        coverImage: resolveBlogAsset(post, post.data.coverImage),
        socialImage: resolveBlogAsset(post, post.data.socialImage),
        sharingImageMetadata: await resolveBlogImageMetadata(post, post.data.socialImage || post.data.coverImage),
      },
    };
  }));
}

const { post, publicSlug, coverImage, socialImage, sharingImageMetadata } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const review = remarkPluginFrontmatter.ludicReview;
const generatedSharingImage = await getReviewSharingImage(post, review);
---

<BlogPostLayout
  frontmatter={{
    ...post.data,
    coverImage,
    socialImage: socialImage || generatedSharingImage?.url,
    socialImageAlt: post.data.socialImage ? post.data.socialImageAlt : generatedSharingImage?.alt || post.data.socialImageAlt,
  }}
  slug={publicSlug}
  articleEntry={post}
  sharingImageMetadata={generatedSharingImage?.metadata || sharingImageMetadata}
  review={review}
>
  <Content />
</BlogPostLayout>
